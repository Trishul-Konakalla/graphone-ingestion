# Copy this file to .env and fill in whichever keys you have.
# The fallback chain only needs ONE of these to demonstrate working - it will
# cascade to the next tier automatically if a key is missing or rate limited.

GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional - raises GitHub's unauthenticated rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=
